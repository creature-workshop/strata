// A stratum with its blobs at the back: the stream zstd -dc emits, and the
// frames it passes over.

specification {
  // A figure: its caption is the title of an outer frame drawn without a border.
  element figure {
    style {
      shape rectangle
      color slate
      opacity 100%
      border none
    }
  }

  // A stratum, drawn as a group.
  element stratum {
    style {
      shape rectangle
      color gray
      opacity 100%
      border solid
    }
  }

  // Frame 0.
  element header {
    style {
      shape rectangle
      color primary
    }
  }

  // A document frame.
  element document {
    style {
      shape rectangle
      color green
    }
  }

  // A text blob, a regular frame.
  element text {
    style {
      shape rectangle
      color amber
    }
  }

  // A binary blob or the seek table, a skippable frame.
  element skippable {
    style {
      shape rectangle
      color muted
      border dashed
    }
  }
}

model {
  fig1a = figure 'Figure 1a. A stratum with its blobs at the back: the stream zstd -dc emits, and the frames it passes over.' {
    s = stratum 'one stratum of jobs.strata' {
      h = header 'frame 0: header' {
        description 'contents [3]; blobs [9f86… lines 1204, 2c1b…]'
      }
      d3 = document 'document 3' {
        description 'refs 9f86… and 2c1b…; zstd -dc emits it'
      }
      t1 = text 'text blob 9f86…' {
        description '1204 lines; zstd -dc emits it; grep sees it'
      }
      b1 = skippable 'binary blob 2c1b…' {
        description 'skippable frame; zstd -dc passes over it'
      }
      seek = skippable 'seek table' {
        description 'skippable frame; every frame\'s size'
      }
    }
  }

  fig1a.s.h -> fig1a.s.d3 'then'
  fig1a.s.d3 -> fig1a.s.t1 'then'
  fig1a.s.t1 -> fig1a.s.b1 'then'
  fig1a.s.b1 -> fig1a.s.seek 'then'
}

views {
  view f1a {
    title 'A stratum with its blobs at the back'
    include fig1a, fig1a.s.*
    autoLayout TopBottom
    rank same { fig1a.s.h, fig1a.s.d3, fig1a.s.t1, fig1a.s.b1, fig1a.s.seek }
  }
}
