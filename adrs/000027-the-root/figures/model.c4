// The root: a corpus's header is pinned by the corpora that read it, and
// every pinned state rebuilds from the header as it stands.

specification {
  // A figure: its caption is the title of an outer frame drawn without a border.
  element figure {
    style {
      shape rectangle
      color slate
      opacity 100%
      border none
    }
  }

  // A corpus, drawn as a group.
  element corpus {
    style {
      shape rectangle
      color gray
      opacity 100%
      border solid
    }
  }

  // A header.
  element header {
    style {
      shape rectangle
      color primary
    }
  }

  // A history entry, with the state it found.
  element entry {
    style {
      shape rectangle
      color green
    }
  }
}

model {
  fig1a = figure 'Figure 1a. A corpus\'s header is pinned by the corpora that read it, and every pinned state rebuilds from the header as it stands.' {
    jobs = corpus 'jobs' {
      jh = header 'header as it stands' {
        description 'fingerprint; index; toc 1..80; history: two entries'
      }
      j1 = entry 'entry 1: scrape@09-20' {
        description 'wrote 1..40; before: none, the corpus began here'
      }
      j2 = entry 'entry 2: scrape@09-21' {
        description 'wrote 41..80; before: sha256:9f86…, toc 40, index 12'
      }
    }

    churn = corpus 'churn, read jobs on 09-21' {
      ch = header 'header' {
        description 'history: read jobs@sha256:9f86…'
      }
    }

    report = corpus 'report, read jobs on 09-22' {
      rh = header 'header' {
        description 'history: read jobs@sha256:2c1b…'
      }
    }
  }

  fig1a.jobs.jh -> fig1a.jobs.j1 'then'
  fig1a.jobs.j1 -> fig1a.jobs.j2 'then'
  fig1a.churn.ch -> fig1a.jobs.jh 'pin 9f86…: rebuild the state before entry 2, hash it, compare'
  fig1a.report.rh -> fig1a.jobs.jh 'pin 2c1b…: hash the header as it stands, compare'
}

views {
  view f1a {
    title 'A header is pinned from outside, and every pinned state rebuilds'
    include fig1a, fig1a.jobs.*, fig1a.churn.*, fig1a.report.*
    autoLayout TopBottom
    rank same { fig1a.jobs.jh, fig1a.jobs.j1, fig1a.jobs.j2 }
  }
}
