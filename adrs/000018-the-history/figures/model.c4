// Three corpora and a report, each naming what it read by seeds and by the
// header digest as it stood.

specification {
  // A figure: its caption is the title of an outer frame drawn without a border.
  element figure {
    style {
      shape rectangle
      color slate
      opacity 100%
      border none
    }
  }

  // A corpus a scraper wrote: a source, reading nothing.
  element source {
    style {
      shape storage
      color primary
    }
  }

  // A corpus a transform wrote from others.
  element derived {
    style {
      shape storage
      color green
    }
  }
}

model {
  fig1a = figure 'Figure 1a. Three corpora and a report, each naming what it read by seeds and by digest, walked back from frame 0 to frame 0.' {
    jobs = source 'jobs' {
      description 'seeds 0013d4fd… history: scrape@09-20 wrote 1..40; scrape@09-21 wrote 41..80; read nothing'
    }
    pipelines = source 'pipelines' {
      description 'seeds 00a0f3c1… history: scrape@09-21 wrote 1..9; read nothing'
    }
    churn = derived 'churn' {
      description 'seeds 07c2e91a… history: churn@09-22 wrote 1..3; read jobs and pipelines'
    }
    report = derived 'report' {
      description 'history: report@09-22 wrote 1; read churn'
    }
  }

  fig1a.jobs -> fig1a.churn 'read at sha256:9f86…'
  fig1a.pipelines -> fig1a.churn 'read at sha256:2c1b…'
  fig1a.churn -> fig1a.report 'read at sha256:e4d0…'
}

views {
  view f1a {
    title 'Every corpus names what it read, by seeds and by digest'
    include fig1a, fig1a.*
    autoLayout LeftRight
  }
}
