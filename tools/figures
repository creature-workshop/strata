#!/usr/bin/env bash
set -eu

USAGE="$(cat <<HELP
Exports each ADR's figures to PNGs beside their LikeC4 sources, where they are
committed and the ADR's markdown links them.

An ADR is a directory <number>-<slug> holding adr.md and a figures/ directory
that is one LikeC4 project. The view named f<id> becomes figures/<id>.png.
Dynamic views come out as sequence diagrams.

    figures adrs/0003-global-adrs
      ->  adrs/0003-global-adrs/figures/1a.png

Expects LikeC4 in node_modules (npm ci), a Playwright browser for the export
(npx playwright install chromium-headless-shell), and Graphviz's dot where
LikeC4 lays out through it.

Usage: figures <adr-dir>...
HELP
)"

TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$TOOLS_DIR/.." && pwd)"
LIKEC4="$REPO_DIR/node_modules/.bin/likec4"
VIEW_PREFIX="f"

ARG_ADRS=""

main() {
  parse_args "$@"
  require_adrs
  require_likec4

  for __main__adr in $ARG_ADRS; do
    export_figures "$__main__adr/figures"
  done
}

: <<'FUN'
Fails when no ADR directory was given.
FUN
require_adrs() {
  if [ -z "$ARG_ADRS" ]; then
    fail "$USAGE"
  fi
}

: <<'FUN'
Fails when the LikeC4 CLI is not installed beside package.json.
FUN
require_likec4() {
  [ -x "$LIKEC4" ] || fail "LikeC4 is not installed; run npm ci"
}

: <<'FUN'
Exports every figure view of the LikeC4 project in directory $1, the views
whose id carries the figure prefix, to a PNG in the same directory, and drops
the prefix from each file name, so view f1a becomes 1a.png. An ADR with no
figures directory exports nothing. The provider keys are cleared from the
environment because LikeC4's preview server loads an AI assistant, and fetches
its packages, when it sees one; an export needs neither.
FUN
export_figures() {
  [ -d "$1" ] || return 0
  validate_sources "$1"
  CHOKIDAR_USEPOLLING=true env \
    -u ANTHROPIC_API_KEY \
    -u OPENAI_API_KEY \
    -u GOOGLE_GENERATIVE_AI_API_KEY \
    -u GEMINI_API_KEY \
    "$LIKEC4" export png \
    --output "$1" \
    --flat \
    --seq \
    --filter "${VIEW_PREFIX}*" \
    "$1" \
    >&2
  require_figures "$1"
  strip_view_prefix "$1"
  log "$1"
}

: <<'FUN'
Fails when the LikeC4 sources in directory $1 do not parse, since an export
draws whatever did parse and exits clean.
FUN
validate_sources() {
  "$LIKEC4" validate "$1" >&2 || fail "the LikeC4 sources in $1 are invalid"
}

: <<'FUN'
Fails when directory $1 holds no exported figure, since LikeC4 reports a
layout that produced nothing as a warning and exits clean.
FUN
require_figures() {
  if [ -z "$(find "$1" -name "${VIEW_PREFIX}*.png" -print -quit)" ]; then
    fail "LikeC4 exported no figure into $1; see its log above"
  fi
}

: <<'FUN'
Renames every <prefix><id>.png in directory $1 to <id>.png.
FUN
strip_view_prefix() {
  for __strip_view_prefix__png in "$1"/"$VIEW_PREFIX"*.png; do
    [ -f "$__strip_view_prefix__png" ] || continue
    __strip_view_prefix__name="$(basename "$__strip_view_prefix__png")"
    mv "$__strip_view_prefix__png" "$1/${__strip_view_prefix__name#"$VIEW_PREFIX"}"
  done
}

log() {
  printf '%s\n' "$*" >&2
}

fail() {
  log "figures: $*"
  exit 1
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help) log "$USAGE"; exit 0 ;;
      -*) fail "unknown option: $1" ;;
      *) ARG_ADRS="$ARG_ADRS $1" ;;
    esac
    shift
  done
}

main "$@"
