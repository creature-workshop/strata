jobs:
  - name: test
    needs: []
    script:
      - "echo \"hi\""
      - |
        one
          two # not a comment

        three
      - |-
        folded onto one line
        and a second
  - keep: |+
      kept

    name: deploy
    rules:
      - - nested
        - sequence
      - if: "$CI_COMMIT_TAG"
    strip: stripped
"on": push
