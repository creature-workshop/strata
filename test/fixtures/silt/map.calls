# The map: every reader verb over the shared document
#
# A map is a box of labelled things. This document is the box the JSON twin
# beside the library also spells, so we can ask jq the same questions. We ask
# for things by their label, ask what kind of thing each one is, count them,
# list the labels, and walk them one by one.

type
string .runner
string .tests."test/a.bats".status
string .tests["test/a.bats"].reads[1]
string .count
string .ratio
string .clean
string .nothing
string .tests
string .missing
string ."a \"quoted\" key: with.dots"
string .text
string .unicode
get .runner
get .tests."test/a.bats".reads
get .tests."test/b.bats"
get .empty
get .none
get .nothing
get
get .
get .missing
get .tests."test/c.bats"
get .tests."test/a.bats".reads[7]
get .runner.deeper
get .tests
has .runner
has .nothing
has .none
has .missing
scalar
len
keys
each
each tag
each-until count
