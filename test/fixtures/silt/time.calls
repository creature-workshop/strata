# One instant, spelled four ways
as t time 2026-09-22T08:10:04.5+02:00
as u time 2026-09-22T06:10:04.500Z
time 2026-09-22t06:10:04.5z
time 2026-09-22 06:10:04.500000000Z
type @t
scalar @t
equals @t $u
